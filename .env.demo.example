# ── WhyCode Live Demo Environment Configuration ─────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://whycode-demo.vercel.app
SERVER_URL=https://whycode-api.onrender.com

# ── Demo Safety & Restrictions ───────────────────────────────────
DEMO_MODE=true
DEMO_READ_ONLY=true
DEMO_REPO_ALLOWLIST=saavi122/GigSure,saavi122/DayOne,acmelogistics/acme-backend
MAX_QUESTION_LENGTH=500
ENABLE_DEMO_CACHE=true

# ── Databases & Cache ────────────────────────────────────────────
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/WhyCodeDemo?retryWrites=true&w=majority
JWT_SECRET=demo_secret_jwt_key_whycode_2026_production
REDIS_URL=rediss://default:<PASSWORD>@<UPSTASH_HOST>:6379

# ── Qdrant Cloud (Managed Vector Storage - 384 dimensions) ───────
QDRANT_URL=https://<CLUSTER_ID>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<YOUR_QDRANT_CLOUD_API_KEY>

# ── Text Embeddings & Reranker ───────────────────────────────────
TEI_EMBEDDINGS_URL=http://127.0.0.1:8080
TEI_RERANKER_URL=http://127.0.0.1:8081

# ── LLM Inference (Local GPU Tunnel / Cloud Endpoint) ───────────
LLM_BASE_URL=https://<YOUR_CLOUDFLARE_TUNNEL_URL>/v1
LLM_MODEL=qwen2.5-coder:3b
LLM_TEMPERATURE=0.0

# ── Demo GitHub App Credentials ──────────────────────────────────
GITHUB_APP_ID=5180500
GITHUB_APP_SLUG=whycode-demo-org
GITHUB_CLIENT_ID=<YOUR_DEMO_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_DEMO_GITHUB_CLIENT_SECRET>
GITHUB_WEBHOOK_SECRET=<YOUR_DEMO_GITHUB_WEBHOOK_SECRET>
GITHUB_PRIVATE_KEY_PATH=/etc/secrets/github-app.private-key.pem

# ── Calibrated Thresholds File ───────────────────────────────────
THRESHOLDS_CONFIG_PATH=./config/thresholds.demo.json
