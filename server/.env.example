# ==============================================================================
# WhyCode Environment Variables Contract
# NOTE: All values left empty intentionally as a configuration template.
# ==============================================================================

# ── Core Server & Database ───────────────────────────────────────────────────
PORT=
NODE_ENV=
MONGO_URI=
JWT_SECRET=
CLIENT_ORIGIN=
CLIENT_URL=
SERVER_URL=
VITE_API_URL=

# ── Redis / Cache / Queue (Supports rediss:// and redis://) ─────────────────
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── Qdrant Cloud / Vector Store ──────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── HuggingFace TEI (Embeddings & Reranker) ──────────────────────────────────
TEI_EMBEDDINGS_URL=
TEI_RERANKER_URL=
INTERNAL_SERVICE_TOKEN=

# ── LLM Provider (vLLM / Ollama / Groq / OpenRouter / OpenAI) ────────────────
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_EXTERNAL=
LLM_TIMEOUT_MS=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# ── Calibration & Thresholds ─────────────────────────────────────────────────
THRESHOLDS_FILE=
RERANK_MIN_SCORE=
MIN_EVIDENCE_CHUNKS=

# ── GitHub App OAuth & Webhooks ──────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_B64=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=
APP_ID=
APP_SLUG=
CLIENT_ID=
CLIENT_SECRET=
PRIVATE_KEY_B64=
WEBHOOK_SECRET=
CALLBACK_URL=

# ── Demo Mode, Privacy & Guardrails ──────────────────────────────────────────
DEMO_MODE=
DEMO_READ_ONLY=
DEMO_REPO_ALLOWLIST=
MAX_QUESTION_LENGTH=
ALLOW_LOCAL_SERVICES=

# ── Proxy & Cookies ──────────────────────────────────────────────────────────
TRUST_PROXY=
COOKIE_SECURE=
COOKIE_SAME_SITE=

# ── Optional Fallbacks & Integrations ────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
