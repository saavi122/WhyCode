{
  "info": {
    "_postman_id": "b3e5b6c3-1d07-4e78-831d-d421cd7de7fa",
    "name": "WhyCode API Collection v2.0",
    "description": "Complete Postman collection for WhyCode multi-tenant AI documentation & knowledge recovery platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Email & Password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ria@paypal.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Initiate GitHub App OAuth Flow",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/github/install", "host": ["{{baseUrl}}"], "path": ["api", "github", "install"] }
          }
        }
      ]
    },
    {
      "name": "2. Repositories & Sync",
      "item": [
        {
          "name": "List Connected Repositories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/repositories", "host": ["{{baseUrl}}"], "path": ["api", "repositories"] }
          }
        },
        {
          "name": "Connect Repository",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"saavi122/GigSure\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/repositories", "host": ["{{baseUrl}}"], "path": ["api", "repositories"] }
          }
        },
        {
          "name": "Trigger Repository Sync",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/repositories/{{repoId}}/sync", "host": ["{{baseUrl}}"], "path": ["api", "repositories", "{{repoId}}", "sync"] }
          }
        },
        {
          "name": "Get Repository Sync Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/repositories/{{repoId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "repositories", "{{repoId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "3. Grounded Knowledge QA (Ask)",
      "item": [
        {
          "name": "Ask Question (Grounded RAG)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repoId\": \"{{repoId}}\",\n  \"question\": \"What is the purpose of the GigSure platform according to the README?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/chat/ask", "host": ["{{baseUrl}}"], "path": ["api", "chat", "ask"] }
          }
        },
        {
          "name": "Ask Canary Fact Query",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repoId\": \"{{repoId}}\",\n  \"question\": \"What port does ZEBRA-CANARY-7391 run on in the canary service?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/chat/ask", "host": ["{{baseUrl}}"], "path": ["api", "chat", "ask"] }
          }
        },
        {
          "name": "Get QA History for Repository",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/chat/history/{{repoId}}", "host": ["{{baseUrl}}"], "path": ["api", "chat", "history", "{{repoId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Intelligence & Drift Reports",
      "item": [
        {
          "name": "List All Reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reports?repositoryId={{repoId}}&status=PENDING_REVIEW",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                { "key": "repositoryId", "value": "{{repoId}}" },
                { "key": "status", "value": "PENDING_REVIEW" }
              ]
            }
          }
        },
        {
          "name": "Generate Drift Report (Manual Trigger)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repositoryId\": \"{{repoId}}\",\n  \"reportType\": \"DRIFT\",\n  \"targetPath\": \"README.md\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reports/generate", "host": ["{{baseUrl}}"], "path": ["api", "reports", "generate"] }
          }
        },
        {
          "name": "Review Report (Approve / Reject)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/review", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "review"] }
          }
        },
        {
          "name": "Export Report as Markdown",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/export", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "export"] }
          }
        }
      ]
    },
    {
      "name": "5. Webhook Ingress (GitHub App)",
      "item": [
        {
          "name": "GitHub Push Webhook Delivery",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Hub-Signature-256", "value": "sha256=COMPUTED_HMAC_SIGNATURE" },
              { "key": "X-GitHub-Event", "value": "push" },
              { "key": "X-GitHub-Delivery", "value": "del-uuid-12345" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repository\": { \"id\": 999999999, \"full_name\": \"saavi122/GigSure\" },\n  \"installation\": { \"id\": 167672802 },\n  \"after\": \"0ca2464b8254e74dcc2ad600d695344beb41c8da\",\n  \"commits\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/github/webhooks", "host": ["{{baseUrl}}"], "path": ["api", "github", "webhooks"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "jwtToken", "value": "" },
    { "key": "repoId", "value": "6ac19a3fbb1ce57fae1480a7" },
    { "key": "reportId", "value": "" }
  ]
}
